# フロントエンド用（すべて公開してよい値。秘密鍵は書かない）
# ローカル開発では `npx supabase status` の API_URL と PUBLISHABLE_KEY を使う
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# VAPID の公開鍵（秘密鍵は supabase/functions/.env と本番の Secrets にだけ置く）
VITE_VAPID_PUBLIC_KEY=
# Edge Functions の URL を差し替えるとき（ローカルで scripts/dev-functions.ts を使う場合のみ）
# VITE_FUNCTIONS_URL=http://127.0.0.1:54329/functions/v1
